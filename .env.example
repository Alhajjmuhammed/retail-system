# Development defaults. Copy to .env and edit.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://retail_app:retail_app@127.0.0.1:5432/retail
REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- production ---------------------------------------------------------
# DEBUG=False
# DJANGO_SETTINGS_MODULE=config.settings.prod
# SECRET_KEY=            # 50+ random characters, or the app refuses to start
# ALLOWED_HOSTS=app.example.com
# POSTGRES_PASSWORD=     # used by compose.yaml to create the database
# BACKUP_REMOTE=         # where ops/backup.sh copies the nightly dump
# SUBSCRIPTION_GRACE_DAYS=7

# Proxies of ours in front of the app (nginx = 1). Used to find the real
# client address behind X-Forwarded-For.
TRUSTED_PROXY_HOPS=1

# Email, for password resets and invitations. Without a host they are only
# written to the log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com

# Receipts and other private uploads (never served by nginx).
PRIVATE_MEDIA_ROOT=/app/private
