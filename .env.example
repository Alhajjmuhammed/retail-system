# Development defaults. Copy to .env and edit.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://retail_app:retail_app@127.0.0.1:5432/retail
REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- production ---------------------------------------------------------
# DEBUG=False
# DJANGO_SETTINGS_MODULE=config.settings.prod
# SECRET_KEY=            # 50+ random characters, or the app refuses to start
# ALLOWED_HOSTS=app.example.com
# POSTGRES_PASSWORD=     # used by compose.yaml to create the database
# APP_DB_PASSWORD=       # the password of the role the app connects as.
#                        # compose passes it to the database when it is first
#                        # created and builds DATABASE_URL from it, so do not
#                        # set DATABASE_URL by hand there. Production refuses
#                        # to start on the development password above.
# BACKUP_REMOTE=         # where ops/backup.sh copies the nightly dump
# SUBSCRIPTION_GRACE_DAYS=7

# How much of the machine the app may take. Three workers and two threads
# suit a box of its own; on a small VPS that runs other things, two workers
# and one Celery process is about 600 MB all in.
# WEB_WORKERS=2
# WEB_THREADS=2
# CELERY_CONCURRENCY=1

# Run without sending any email. Password resets then have to be done by an
# admin under Settings > Staff, and the forgot-password page says so rather
# than pretending a link is on its way.
# EMAIL_OFF=true

# Proxies of ours in front of the app (nginx = 1). Used to find the real
# client address behind X-Forwarded-For.
TRUSTED_PROXY_HOPS=1

# Email, for password resets and invitations. Without a host they are only
# written to the log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com

# Receipts and other private uploads (never served by nginx). Left unset in
# development, where they go to ./private; in the container the path must be
# the volume compose mounts.
# PRIVATE_MEDIA_ROOT=/app/private
